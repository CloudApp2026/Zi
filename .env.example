# Configure as secrets in your backend host. Never commit the real .env.
REPLICATE_API_TOKEN=replace_with_your_replicate_token
ALLOWED_ORIGINS=https://cloudapp2026.github.io,http://localhost:8080

# Protects spend/write endpoints. Use a long random value; paste the same one in the Releases page.
ADMIN_TOKEN=replace_with_a_long_random_string
BOT_ENABLED=1

# Full-song generation (Replicate official MiniMax Music 2.6)
# Accepts prompt + lyrics + is_instrumental=false + output_format; no duration field.
MUSIC_MODEL=minimax/music-2.6
MODEL_SUPPORTS_VOCALS=1
MODEL_LYRICS_KEY=lyrics
MODEL_DURATION_KEY=
MODEL_EXTRA_INPUT={"is_instrumental": false, "output_format": "mp3", "lyrics_optimizer": true}
# Configure a Replicate text model whose input schema accepts LYRICS_PROMPT_KEY.
LYRICS_MODEL=meta/meta-llama-3-8b-instruct
LYRICS_PROMPT_KEY=prompt
LYRICS_EXTRA_INPUT={"max_new_tokens": 1200, "temperature": 0.8}
# Enable commercial release only after checking the current model licence and your use case.
MODEL_LICENSE_COMMERCIAL=0
# 2.6 can generate full songs (commonly 2-4 min, up to 6 min); use one prediction.
SEGMENT_SECONDS=300

# Compose/Docker set these already; override only if you mount storage elsewhere.
# DB_PATH=/app/data/aio.db
# WORK_DIR=/app/data/work
